<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniSpec.Core\OmniSpec.Core.csproj" />
  </ItemGroup>

  <!-- The mock provider is development-only and is never compiled into Release builds. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Mock\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OmniSpec.Tests" />
  </ItemGroup>
</Project>

