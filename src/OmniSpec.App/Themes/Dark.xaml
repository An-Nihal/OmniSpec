<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#0F1115</Color>
    <Color x:Key="Color.Sidebar">#13161C</Color>
    <Color x:Key="Color.Surface">#181B22</Color>
    <Color x:Key="Color.SurfaceAlt">#1E222B</Color>
    <Color x:Key="Color.SurfaceHover">#252A35</Color>
    <Color x:Key="Color.Border">#2A2F3A</Color>
    <Color x:Key="Color.Text">#E8EBF1</Color>
    <Color x:Key="Color.TextSecondary">#A3AAB8</Color>
    <Color x:Key="Color.TextMuted">#6C7383</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Good" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.GoodSoft" Color="#1A3DD68C" />
    <SolidColorBrush x:Key="Brush.Info" Color="#5AB0FF" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#1A5AB0FF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFB547" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1FFFB547" />
    <SolidColorBrush x:Key="Brush.Critical" Color="#FF5C6C" />
    <SolidColorBrush x:Key="Brush.CriticalSoft" Color="#1FFF5C6C" />
    <SolidColorBrush x:Key="Brush.ChartGrid" Color="#232733" />
    <SolidColorBrush x:Key="Brush.Track" Color="#262B36" />
    <SolidColorBrush x:Key="Brush.Series2" Color="#F7768E" />
    <SolidColorBrush x:Key="Brush.Series3" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.Series4" Color="#E0AF68" />
    <SolidColorBrush x:Key="Brush.WidgetBackground" Color="#E6111318" />
    <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#B3000000" />
</ResourceDictionary>
