<Window x:Class="OmniSpec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
        Title="OmniSpec" Width="1320" Height="860" MinWidth="1080" MinHeight="640"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" Icon="Assets/omnispec.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,14,0,22">
                    <Image Source="Assets/omnispec-256.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OmniSpec" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Your Entire PC. One Clear View." FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <Button Command="{Binding ToggleWidgetCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE737;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Desktop widget" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                        <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <Border Background="{DynamicResource Brush.CriticalSoft}" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                            Visibility="{Binding IsMock, Converter={StaticResource Visible}}">
                        <TextBlock Text="MOCK DATA — development build" Foreground="{DynamicResource Brush.Critical}" FontWeight="Bold" FontSize="11" />
                    </Border>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Current}" Style="{StaticResource List.Plain}"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid>
                <TextBlock Text="{Binding Current.Title}" Margin="24,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE921;" Width="46" Height="44" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE922;" Width="46" Height="44" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE8BB;" Width="46" Height="44" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Privilege / alert banners -->
            <StackPanel Grid.Row="1" Margin="24,0,24,8">
                <ItemsControl ItemsSource="{Binding RecentAlerts}" MaxHeight="120">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Banner}" Margin="0,0,0,6" Padding="12,6">
                                <TextBlock Style="{StaticResource Text.Base}" TextWrapping="Wrap">
                                    <Run Text="{Binding Timestamp, StringFormat=HH:mm, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="—" />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear alerts" Command="{Binding ClearAlertsCommand}" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Right"
                        Visibility="{Binding RecentAlerts.Count, Converter={StaticResource Visible}}" />
            </StackPanel>

            <ContentControl Grid.Row="2" Content="{Binding Current}" Focusable="False" />

            <!-- Status bar -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,6">
                <Grid>
                    <TextBlock Text="{Binding ProviderStatus}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,200,0" />
                    <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
