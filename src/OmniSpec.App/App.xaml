<Application x:Class="OmniSpec.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OmniSpec.App.Converters"
             xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Views/Shared.xaml" />
                <ResourceDictionary Source="Views/HardwareViews.xaml" />
                <ResourceDictionary Source="Views/DeviceViews.xaml" />
                <ResourceDictionary Source="Views/ToolViews.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Brush.Accent" Color="#4F8CFF" />
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#334F8CFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
