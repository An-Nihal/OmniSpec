<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
                    xmlns:c="clr-namespace:OmniSpec.App.Controls">

    <!-- ============================================================ STORAGE -->
    <DataTemplate DataType="{x:Type vm:StorageViewModel}">
        <Grid Margin="24,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="Storage &amp; drive health" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Secondary}" />
                </StackPanel>
                <Button Content="Refresh now" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource ListItem.Card}" Margin="0,0,12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveItem}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Background="{Binding Level, Converter={StaticResource HealthBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding LevelText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Level, Converter={StaticResource HealthBrush}}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay, Converter={StaticResource NanZero}}" Maximum="100"
                                         Foreground="{Binding UsedPercent, Converter={StaticResource LoadBrush}}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding TempText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedDrive}"
                          Visibility="{Binding Converter={StaticResource Visible}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Background="{Binding Level, Converter={StaticResource HealthBrush}, ConverterParameter=soft}"
                            BorderBrush="{Binding Level, Converter={StaticResource HealthBrush}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource Text.H1}" Foreground="{Binding Level, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" VerticalAlignment="Bottom" Margin="14,0,0,3" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Text="Verdict combines only standardized indicators: Windows health status, NVMe/Windows wear counters, spare capacity and uncorrected errors. Vendor-specific raw SMART attributes are never interpreted." />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" ToolTip="{Binding Source}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Severity, Converter={StaticResource HealthBrush}}" Margin="0,5,10,0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Base}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Source, StringFormat=Source: {0}}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Health metrics" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="Hover a value to see where it came from." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Health}" Style="{StaticResource Rows}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Drive" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Identity}" Style="{StaticResource Rows}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Visibility="{Binding HasTemperatureHistory, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Temperature history" Style="{StaticResource ChartTitle}" />
                            <c:LineChart Series="{Binding TempSeries}" Height="130" Unit="°" Margin="0,8,0,0"
                                         EmptyText="Collecting temperature data…" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Partitions" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Partitions}" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding PartitionNumber}" Width="40" />
                                    <DataGridTextColumn Header="Letter" Binding="{Binding DriveLetter}" Width="60" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                    <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="90" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                    <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeBytes, StringFormat=N0}" Width="*" />
                                    <DataGridTextColumn Header="Free (bytes)" Binding="{Binding FreeBytes, StringFormat=N0}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasReliability, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Windows reliability counters" Style="{StaticResource Text.H3}" />
                                
                                <ItemsControl ItemsSource="{Binding Reliability}" Style="{StaticResource Rows}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding HasSmart, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="SMART / NVMe health data" Style="{StaticResource Text.H3}" />
                                
                                <ItemsControl ItemsSource="{Binding Smart}" Style="{StaticResource Rows}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ SENSORS -->
    <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
        <Grid Margin="24,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Text="Sensor center" Style="{StaticResource Text.H1}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SensorCount, StringFormat={}{0} sensors shown · min/max/avg since OmniSpec started}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Tag="Search sensors" />
                <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" Width="150" Margin="8,0,0,0" />
                <Button Content="Reset min/max" Command="{Binding ResetStatisticsCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                            <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,10" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SENSOR" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="1" Text="CURRENT" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="2" Text="MIN" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="3" Text="MAX" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="4" Text="AVG" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="5" Text="LIMIT" Style="{StaticResource Text.Label}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SensorRow}">
                                                <Button Style="{StaticResource Button.Row}"
                                                        Command="{Binding DataContext.SelectSensorCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="Val" Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Text.Base}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding MinText}" Style="{StaticResource Text.Secondary}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding MaxText}" Style="{StaticResource Text.Secondary}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding AvgText}" Style="{StaticResource Text.Secondary}" />
                                                        <TextBlock Grid.Column="5" Text="{Binding LimitText}" Style="{StaticResource Text.Caption}" />
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                        <Setter TargetName="Val" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                        <Setter TargetName="Val" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                        <Setter TargetName="Val" Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                            <c:LineChart Series="{Binding SelectedSeries}" Limit="{Binding SelectedLimit}" Height="150" Margin="0,10,0,10" ValueFormat="0.#"
                                         EmptyText="No history for this sensor" />
                            <TextBlock Text="Custom warning limit" Style="{StaticResource Text.Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBox Text="{Binding LimitInput, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Leave empty to remove the limit" />
                                <Button Content="Apply" Command="{Binding ApplyLimitCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="When the sensor stays at or above this value, OmniSpec shows a notification (once, until it recovers)." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ NETWORK -->
    <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <Grid Margin="0,0,12,16">
                    <StackPanel>
                        <TextBlock Text="Network" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Throughput measured locally from interface counters. Nothing is sent to any server." Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox Content="Show virtual adapters" IsChecked="{Binding ShowVirtual}" Margin="0,0,14,0" />
                        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" Width="300" DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding DownText}" Style="{StaticResource Text.Value}" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding DownStats}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="UPLOAD" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding UpText}" Style="{StaticResource Text.Value}" Foreground="{DynamicResource Brush.Series2}" />
                            <TextBlock Text="{Binding UpStats}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Throughput" Style="{StaticResource ChartTitle}" />
                        <c:LineChart Series="{Binding Series}" Height="200" Margin="0,10,0,0" Unit="" ValueFormat="0" EmptyText="Select an active adapter" />
                        <TextBlock Text="Values in bytes per second" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Adapter" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource Rows}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============================================================ BATTERY -->
    <DataTemplate DataType="{x:Type vm:BatteryViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="Battery &amp; power" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />
                <Border Style="{StaticResource Banner.Info}" Visibility="{Binding HasBattery, Converter={StaticResource Collapsed}}">
                    <StackPanel>
                        <TextBlock Text="No battery detected" Style="{StaticResource Text.H3}" />
                        <TextBlock Style="{StaticResource Text.Base}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="This computer reports no system battery. Battery health is shown on laptops and other battery-powered devices." />
                        <TextBlock Text="{Binding PowerPlan, StringFormat=Active power plan: {0}}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasBattery, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid Width="140" Height="140">
                                <c:RingGauge Value="{Binding Percent}" Thickness="12" Brush="{DynamicResource Brush.Series3}" />
                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource Text.Value}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.H2}" />
                                <TextBlock Text="{Binding PowerPlan, StringFormat=Power plan: {0}}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Measured / reported" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="Values reported by the battery firmware and Windows." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Measured}" Style="{StaticResource Rows}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Estimates" Style="{StaticResource Text.H3}" />
                                <TextBlock Text="Calculated values — not direct measurements." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Estimated}" Style="{StaticResource Rows}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
