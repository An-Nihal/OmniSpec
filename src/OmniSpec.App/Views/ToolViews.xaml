<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
                    xmlns:c="clr-namespace:OmniSpec.App.Controls"
                    xmlns:fps="clr-namespace:OmniSpec.Core.Fps;assembly=OmniSpec.Core">

    <!-- Info row (system information) -->
    <DataTemplate x:Key="InfoRow" DataType="{x:Type vm:InfoRowView}">
        <Grid Margin="0,5" ToolTip="{Binding ToolTipText}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Base}" TextWrapping="Wrap"
                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="SettingHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,16,6" />
    </Style>

    <!-- ============================================================ SYSTEM INFORMATION -->
    <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
        <Grid Margin="24,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Margin="0,0,12,14">
                <StackPanel>
                    <TextBlock Text="System information" Style="{StaticResource Text.H1}" />
                    <TextBlock Style="{StaticResource Text.Secondary}">
                        <Run Text="{Binding CollectedText, Mode=OneWay}" /><Run Text="  ·  hover any value to see its source" />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Accent}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="Show serial numbers &amp; identifiers" IsChecked="{Binding RevealSensitive}" Margin="0,0,16,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="Export TXT" Command="{Binding ExportTextCommand}" Margin="0,0,8,0" />
                    <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Style="{StaticResource List.Plain}" Margin="0,0,12,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Card}">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedSection}">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InfoRow}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Children}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Flat}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InfoRow}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ FPS & GAMING -->
    <DataTemplate DataType="{x:Type vm:GamingViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel>
                <TextBlock Text="FPS &amp; gaming performance" Style="{StaticResource Text.H1}" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,12,16"
                           Text="Frame rate is measured per application with Intel PresentMon. There is no meaningful 'desktop FPS', so OmniSpec only shows FPS for the program you select." />

                <!-- Setup required -->
                <Border Style="{StaticResource Banner}" Visibility="{Binding NeedsSetup, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="PresentMon is required for FPS measurement" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{Binding ProviderMessage}" Style="{StaticResource Text.Base}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="1. Download the PresentMon console application (PresentMon-x.y.z-x64.exe, MIT license) from the official GameTechDev GitHub releases.  2. Select it below, or put it in a 'tools' folder next to OmniSpec.exe.  OmniSpec never downloads or installs PresentMon or any service for you." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open PresentMon releases" Command="{Binding OpenPresentMonReleasesCommand}" Margin="0,0,8,0" />
                            <Button Content="Select PresentMon executable…" Command="{Binding BrowsePresentMonCommand}" Style="{StaticResource Button.Primary}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Target application" Style="{StaticResource Text.H3}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Display" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="&#xE72C;" Style="{StaticResource Button.Icon}" Command="{Binding RefreshProcessesCommand}" ToolTip="Refresh list" />
                                <CheckBox Content="All processes" IsChecked="{Binding ShowAllProcesses}" Margin="8,0,12,0" />
                                <Button Content="Start capture" Command="{Binding StartCommand}" Style="{StaticResource Button.Primary}" IsEnabled="{Binding CanStart}" Margin="0,0,8,0" />
                                <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsCapturing}" Margin="0,0,8,0" />
                                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="Show in-game overlay while capturing" IsChecked="{Binding ShowOverlay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastStopReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="{Binding LastStopReason, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding ExecutablePath, StringFormat=PresentMon: {0}}" Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding ExecutablePath, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CURRENT FPS" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding FpsText}" FontSize="56" FontWeight="Bold" Style="{StaticResource Text.Base}" FontFamily="{StaticResource Font.Display}" />
                            <TextBlock Text="{Binding FrameTimeText, StringFormat=Last frame {0}}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Frame time" Style="{StaticResource ChartTitle}" />
                            <TextBlock Text="Last 10 seconds of the capture timeline (lower and flatter is better)" Style="{StaticResource Text.Caption}" />
                            <c:LineChart Series="{Binding FrameTimeSeries}" Height="150" WindowSeconds="10" Unit=" ms" ValueFormat="0.#" Fill="False" Margin="0,8,0,0"
                                         EmptyText="Start a capture to see frame times" />
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Live}" Style="{StaticResource Rows}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Session summary" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SessionSummary}" Style="{StaticResource Rows}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="System during session" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SystemDuringSession}" Style="{StaticResource Rows}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============================================================ PROCESSES -->
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <Grid Margin="24,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Text="Processes" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" />
            </StackPanel>
            <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10"
                     Tag="Search by name or PID" />
            <Border Grid.Row="2" Style="{StaticResource Card.Flat}" Padding="4">
                <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" SortMemberPath="Name" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="62" SortMemberPath="Pid" />
                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="66" SortMemberPath="Cpu" />
                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="86" SortMemberPath="Memory" />
                        <DataGridTextColumn Header="Mem %" Binding="{Binding MemoryPercent}" Width="62" SortMemberPath="MemoryPercent" />
                        <DataGridTextColumn Header="Private" Binding="{Binding PrivateText}" Width="86" SortMemberPath="PrivateBytes" />
                        <DataGridTextColumn Header="Disk read" Binding="{Binding DiskReadText}" Width="86" SortMemberPath="DiskRead" />
                        <DataGridTextColumn Header="Disk write" Binding="{Binding DiskWriteText}" Width="86" SortMemberPath="DiskWrite" />
                        <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="62" SortMemberPath="Threads" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Top CPU" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TopCpu}" Style="{StaticResource Rows}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Top memory" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TopMemory}" Style="{StaticResource Rows}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{Binding Pid, StringFormat=PID {0}}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                            <TextBlock Text="Path" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding Path, TargetNullValue='—'}" Style="{StaticResource Text.Base}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Started" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding StartTime, TargetNullValue='—', StringFormat=g}" Style="{StaticResource Text.Base}" Margin="0,0,0,8" />
                            <Button Content="Open file location" Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left" />
                            <TextBlock Text="OmniSpec is read-only: it never terminates or modifies processes." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ============================================================ SETTINGS -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SettingHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" Width="180" />
                            <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="theme" IsChecked="{Binding IsDark}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="theme" IsChecked="{Binding IsLight}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Accent color" Style="{StaticResource SettingLabel}" Width="180" />
                            <ItemsControl ItemsSource="{Binding Accents}" ItemsPanel="{StaticResource WrapPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,8,0" ToolTip="{Binding Name}" Cursor="Hand"
                                                Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Ellipse Fill="{Binding Hex}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="2" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Monitoring &amp; history" Style="{StaticResource SettingHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Sensor refresh interval (seconds)" Style="{StaticResource SettingLabel}" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SensorIntervalSeconds}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SensorIntervalSeconds, StringFormat={}{0:0.0} s}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="1" Text="Process refresh interval (seconds)" Style="{StaticResource SettingLabel}" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ProcessIntervalSeconds}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ProcessIntervalSeconds, StringFormat={}{0:0} s}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="2" Text="Storage health refresh (seconds)" Style="{StaticResource SettingLabel}" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="15" Maximum="600" TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding StorageIntervalSeconds}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding StorageIntervalSeconds, StringFormat={}{0} s}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Grid.Row="3" Text="In-memory history length (minutes)" Style="{StaticResource SettingLabel}" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HistoryMinutes}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding HistoryMinutes, StringFormat={}{0} min}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                        <CheckBox Content="Record history to CSV files on disk (one file per day, kept 30 days)" IsChecked="{Binding HistoryLoggingEnabled}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="48,4,0,0">
                            <TextBlock Text="Every" Style="{StaticResource SettingLabel}" />
                            <TextBox Text="{Binding HistoryLogIntervalSeconds}" Width="60" />
                            <TextBlock Text="seconds" Style="{StaticResource SettingLabel}" Margin="8,6,16,6" />
                            <Button Content="Open history folder" Command="{Binding OpenHistoryFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Alerts" Style="{StaticResource SettingHeader}" />
                        <CheckBox Content="Enable alerts (Windows notifications)" IsChecked="{Binding AlertsEnabled}" />
                        <CheckBox Content="Notify when a drive reports a warning or critical health status" IsChecked="{Binding DriveHealthAlerts}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CPU temperature (°C)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding CpuTemperatureLimit}" />
                            <TextBlock Grid.Column="3" Text="GPU temperature (°C)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Column="4" Text="{Binding GpuTemperatureLimit}" />
                            <TextBlock Grid.Row="1" Text="Drive temperature (°C)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DriveTemperatureLimit}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="RAM usage (%)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RamUsageLimit}" />
                            <TextBlock Grid.Row="2" Text="Low disk space (free %)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LowDiskFreeLimit}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Battery wear (%)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding BatteryWearLimit}" />
                            <TextBlock Grid.Row="3" Text="Condition must persist (seconds)" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AlertSustainSeconds}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Each alert is shown once and only again after the condition has cleared. Per-sensor limits can be set on the Sensors page." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Desktop widget" Style="{StaticResource SettingHeader}" />
                        <TextBlock Text="Metrics shown in the widget" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding WidgetMetrics}" ItemsPanel="{StaticResource WrapPanel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Width="250" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Right-click the widget for opacity, always-on-top, pin-to-desktop, compact mode and lock position." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FPS &amp; gaming" Style="{StaticResource SettingHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PresentMon executable" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding PresentMonPath, UpdateSourceTrigger=LostFocus}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Browse…" Command="{Binding BrowsePresentMonCommand}" Margin="0,0,8,0" />
                                <Button Content="Download page" Command="{Binding OpenPresentMonReleasesCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Extra arguments" Style="{StaticResource SettingLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PresentMonArguments, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0"
                                     ToolTip="Appended to the PresentMon command line (advanced)" />
                            <TextBlock Grid.Row="2" Text="Overlay position" Style="{StaticResource SettingLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OverlayCorners}" SelectedItem="{Binding OverlayCorner}" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </Grid>
                        <CheckBox Content="Show in-game overlay while capturing" IsChecked="{Binding ShowOverlay}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="The overlay is a click-through, always-on-top window. It is visible over borderless/windowed games; exclusive full-screen games may hide it." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Window behaviour" Style="{StaticResource SettingHeader}" />
                        <CheckBox Content="Minimize to the system tray" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Content="Closing the window keeps OmniSpec running in the tray" IsChecked="{Binding CloseToTray}" />
                        <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" />
                        <CheckBox Content="Start with Windows (current user)" IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Privacy" Style="{StaticResource SettingHeader}" />
                        <CheckBox Content="Show serial numbers, MAC/IP addresses, hostname and user name" IsChecked="{Binding ShowSensitiveIdentifiers}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="OmniSpec works fully offline. It has no telemetry, analytics, accounts or advertising and never uploads system information. Exports are only written to files you choose." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sensor access" Style="{StaticResource SettingHeader}" />
                        <CheckBox Content="Start OmniSpec with full sensor access automatically" IsChecked="{Binding AlwaysRunAsAdministrator}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding AutoAdminHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="48,0,0,12" />
                        <TextBlock Text="Sensor groups (changes apply after restart)" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                        <ItemsControl ItemsPanel="{StaticResource WrapPanel}">
                            <CheckBox Content="CPU" IsChecked="{Binding EnableCpuSensors}" Width="150" />
                            <CheckBox Content="GPU" IsChecked="{Binding EnableGpuSensors}" Width="150" />
                            <CheckBox Content="Motherboard" IsChecked="{Binding EnableMotherboardSensors}" Width="150" />
                            <CheckBox Content="Storage" IsChecked="{Binding EnableStorageSensors}" Width="150" />
                            <CheckBox Content="Memory" IsChecked="{Binding EnableMemorySensors}" Width="150" />
                            <CheckBox Content="Coolers / controllers" IsChecked="{Binding EnableControllerSensors}" Width="180" />
                            <CheckBox Content="PSU" IsChecked="{Binding EnablePsuSensors}" Width="150" />
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SettingHeader}" />
                        <TextBlock Style="{StaticResource Text.Base}">
                            <Run Text="OmniSpec " FontWeight="SemiBold" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" — Your Entire PC. One Clear View." Foreground="{DynamicResource Brush.TextSecondary}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DataFolder, StringFormat=Data folder: {0}}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        <TextBlock Text="Portable mode (portable.txt found next to OmniSpec.exe)" Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding IsPortable, Converter={StaticResource Visible}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                            <Button Content="Third-party notices" Command="{Binding OpenThirdPartyNoticesCommand}" Margin="0,0,8,0" />
                            <Button Content="Project on GitHub" Command="{Binding OpenRepositoryCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="MIT licensed. Uses LibreHardwareMonitorLib (MPL-2.0) and optionally Intel PresentMon (MIT, user-supplied)." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
