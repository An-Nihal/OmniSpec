<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
                    xmlns:c="clr-namespace:OmniSpec.App.Controls">

    <ItemsPanelTemplate x:Key="OverlayVertical">
        <StackPanel Orientation="Vertical" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="OverlayHorizontal">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Overlay content, shared by the overlay window and the live preview on the Overlay page.
         Fixed high-contrast colors so it stays readable over any game, in light or dark theme. -->
    <DataTemplate x:Key="OverlayContent" DataType="{x:Type vm:OverlayViewModel}">
        <Border Background="#C80E1014" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6"
                TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.Foreground="White">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
            </Border.LayoutTransform>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel" Value="{StaticResource OverlayVertical}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHorizontal}" Value="True">
                                    <Setter Property="ItemsPanel" Value="{StaticResource OverlayHorizontal}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OverlayRow}">
                            <StackPanel Orientation="Horizontal" Margin="0,1,14,1" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" FontWeight="Bold" FontSize="12"
                                           MinWidth="38" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Values}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:OverlayValue}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Bottom">
                                                    <TextBlock.Style>
                                                        <!-- Color comes from a style setter so warning/primary triggers can override it. -->
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="14" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                    <Setter Property="FontSize" Value="20" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="1">
                                                                    <Setter Property="Foreground" Value="#FFFFB547" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="2">
                                                                    <Setter Property="Foreground" Value="#FFFF5C6C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Unit}" FontSize="10.5" Foreground="#B3FFFFFF" Margin="3,0,0,1" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <c:LineChart Series="{Binding FrameTimeSeries}" Visibility="{Binding ShowGraph, Converter={StaticResource Visible}}"
                             Height="34" MinWidth="220" ShowAxis="False" Fill="False" WindowSeconds="5" EmptyText="" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================ OVERLAY SETTINGS PAGE -->
    <DataTemplate DataType="{x:Type vm:OverlayPageViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="In-game overlay" Style="{StaticResource Text.H1}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,12,16"
                               Text="Choose exactly what appears over your games. The overlay is a separate, click-through window that never touches the game, so it is safe with anti-cheat systems." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Enable the in-game overlay" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DetectedText}" Style="{StaticResource Text.Caption}" Margin="48,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Show overlay" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="When a game is running" GroupName="ovmode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Games}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Always" GroupName="ovmode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Always}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Only with shortcut" GroupName="ovmode"
                                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Manual}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Show / hide shortcut" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    <Button Content="Apply" Command="{Binding ApplyHotkeyCommand}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="FPS" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                <CheckBox Grid.Row="2" Grid.Column="1" Content="Measure FPS automatically for the game in front" IsChecked="{Binding AutoCapture}" Margin="0,10,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="What to show" Style="{StaticResource Text.H2}" />
                                <Button Content="Reset to default" Command="{Binding ResetItemsCommand}" HorizontalAlignment="Right" Style="{StaticResource Button.Subtle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Groups}" ItemsPanel="{StaticResource WrapPanel}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OverlayItemGroup}">
                                        <StackPanel Width="210" Margin="0,0,16,12">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:OverlayItemOption}">
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Position" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Corners}" SelectedItem="{Binding Corner}" Width="200" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Text="Layout" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0.7" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Scale}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Scale, StringFormat={}{0:P0}}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,8,0,0" />
                                <TextBlock Grid.Row="3" Text="Opacity" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Opacity}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource Text.Base}" VerticalAlignment="Center" Margin="10,8,0,0" />
                            </Grid>
                            <CheckBox Content="Colorful values (usage, temperature, clock, power, fan and memory each have their own color)" IsChecked="{Binding ColorfulValues}" Margin="0,10,0,0" />
                            <CheckBox Content="Color temperatures and memory amber/red near your alert limits" IsChecked="{Binding ColorWarnings}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Game detection" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="A program is treated as a game when its window fills the screen. Tip: games in Borderless or Windowed-fullscreen mode always show the overlay." />
                            <TextBlock Text="Always treat as games (program names, comma separated)" Style="{StaticResource Text.Secondary}" Margin="0,4,0,4" />
                            <TextBox Text="{Binding AlwaysGamesText, UpdateSourceTrigger=LostFocus}" Tag="e.g. MyGame, AnotherGame" />
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Never show the overlay for" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                <Button Content="Reset list" Command="{Binding ResetExclusionsCommand}" HorizontalAlignment="Right" Style="{StaticResource Button.Subtle}" />
                            </Grid>
                            <TextBox Text="{Binding ExcludedAppsText, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Live preview" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="FPS values appear while a game is being measured." Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />
                            <Border Background="#FF2A3140" CornerRadius="8" Padding="16" MinHeight="120">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Border.Effect>
                                <ContentControl Content="{Binding Overlay}" ContentTemplate="{StaticResource OverlayContent}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Border>
                            <CheckBox Content="Show the overlay on screen now (test)" IsChecked="{Binding TestOverlay}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
