<Window x:Class="OmniSpec.App.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OmniSpec.App.ViewModels"
        Title="OmniSpec widget" Width="280" SizeToContent="Height" MinWidth="200" MaxWidth="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource Font.Ui}"
        Opacity="{Binding Opacity}" UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open dashboard" Click="OpenDashboard_Click" />
            <Separator />
            <MenuItem Header="Always on top" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}" />
            <MenuItem Header="Pin to desktop (stay behind windows)" IsCheckable="True" IsChecked="{Binding PinToDesktop}" />
            <MenuItem Header="Compact layout" IsCheckable="True" IsChecked="{Binding Compact}" />
            <MenuItem Header="Lock position" IsCheckable="True" IsChecked="{Binding Locked}" />
            <Separator />
            <MenuItem Header="Opacity 100%" Click="Opacity_Click" Tag="1.0" />
            <MenuItem Header="Opacity 85%" Click="Opacity_Click" Tag="0.85" />
            <MenuItem Header="Opacity 70%" Click="Opacity_Click" Tag="0.7" />
            <MenuItem Header="Opacity 50%" Click="Opacity_Click" Tag="0.5" />
            <Separator />
            <MenuItem Header="Choose metrics…" Click="Metrics_Click" />
            <MenuItem Header="Hide widget" Command="{Binding HideCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{DynamicResource Brush.WidgetBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="14" Padding="14,10,14,12" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/omnispec-256.png" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock Text="OmniSpec" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="  MOCK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Critical}"
                               Visibility="{Binding IsMock, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" FontSize="9" Content="&#xE921;" Command="{Binding ToggleCollapsedCommand}" ToolTip="Collapse" />
                    <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" FontSize="9" Content="&#xE8BB;" Command="{Binding HideCommand}" ToolTip="Hide (restore from tray)" />
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding IsCollapsed, Converter={StaticResource Collapsed}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WidgetRow}">
                        <Grid x:Name="Root" Margin="0,3" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                       FontFamily="{StaticResource Font.Display}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="3" Margin="0,3,0,0" Maximum="100"
                                         Value="{Binding Bar, Mode=OneWay, Converter={StaticResource NanZero}}" Foreground="{Binding Bar, Converter={StaticResource LoadBrush}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Compact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Root" Property="Margin" Value="0,1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
